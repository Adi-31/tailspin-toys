---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
const games = await getAllGames(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <section class="mb-8 rounded-2xl border border-slate-700 bg-slate-900/70 p-6 shadow-lg" aria-label="Filter games">
      <form method="get" action="/" data-testid="game-filters-form" class="space-y-6">
        <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <h2 class="text-xl font-semibold text-slate-100">Filter games</h2>
            <p class="text-sm text-slate-400">Narrow the catalog by category and publisher.</p>
          </div>
          <a
            href="/"
            class="inline-flex items-center justify-center rounded-md border border-slate-600 px-3 py-2 text-sm font-medium text-slate-200 transition-colors hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500"
            data-testid="clear-filters-link"
          >
            Clear filters
          </a>
        </div>

        <fieldset class="space-y-3" aria-label="Filter by category">
          <legend class="text-sm font-medium uppercase tracking-wide text-slate-300">Category</legend>
          <div class="flex flex-wrap gap-3">
            {categories.map((category) => (
              <label
                class="inline-flex items-center gap-2 rounded-full border border-slate-600 bg-slate-800 px-3 py-2 text-sm text-slate-200 transition-colors hover:border-blue-500/60 hover:bg-slate-700 focus-within:ring-2 focus-within:ring-blue-500"
                data-testid={`category-filter-${category.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
              >
                <input
                  type="checkbox"
                  name="category"
                  value={category}
                  class="h-4 w-4 rounded border-slate-500 bg-slate-900 text-blue-500 focus:ring-blue-500"
                  data-testid={`category-filter-checkbox-${category.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
                  aria-label={`Filter by ${category}`}
                />
                <span>{category}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset class="space-y-3" aria-label="Filter by publisher">
          <legend class="text-sm font-medium uppercase tracking-wide text-slate-300">Publisher</legend>
          <div class="flex flex-wrap gap-3">
            {publishers.map((publisher) => (
              <label
                class="inline-flex items-center gap-2 rounded-full border border-slate-600 bg-slate-800 px-3 py-2 text-sm text-slate-200 transition-colors hover:border-purple-500/60 hover:bg-slate-700 focus-within:ring-2 focus-within:ring-blue-500"
                data-testid={`publisher-filter-${publisher.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
              >
                <input
                  type="checkbox"
                  name="publisher"
                  value={publisher}
                  class="h-4 w-4 rounded border-slate-500 bg-slate-900 text-purple-500 focus:ring-purple-500"
                  data-testid={`publisher-filter-checkbox-${publisher.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
                  aria-label={`Filter by ${publisher}`}
                />
                <span>{publisher}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <div class="flex items-center gap-3">
          <button
            type="submit"
            class="inline-flex items-center justify-center rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500"
            data-testid="apply-filters-button"
          >
            Apply filters
          </button>
        </div>
      </form>
    </section>

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games match the selected filters." />
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      )}
    </div>
  </div>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-testid="game-filters-form"]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));

  if (form) {
    const readCheckedValues = (name: string): string[] =>
      Array.from(form.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`)).map((input) => input.value);

    const setCheckedValues = (name: string, values: string[]) => {
      const inputs = Array.from(form.querySelectorAll<HTMLInputElement>(`input[name="${name}"]`));
      inputs.forEach((input) => {
        input.checked = values.includes(input.value);
      });
    };

    const applyFilters = () => {
      const selectedCategories = readCheckedValues('category');
      const selectedPublishers = readCheckedValues('publisher');

      cards.forEach((card) => {
        const category = card.getAttribute('data-game-category') ?? '';
        const publisher = card.getAttribute('data-game-publisher') ?? '';
        const matchesCategory = selectedCategories.length === 0 || selectedCategories.includes(category);
        const matchesPublisher = selectedPublishers.length === 0 || selectedPublishers.includes(publisher);
        card.hidden = !(matchesCategory && matchesPublisher);
      });

      const params = new URLSearchParams();
      selectedCategories.forEach((value) => params.append('category', value));
      selectedPublishers.forEach((value) => params.append('publisher', value));
      const nextUrl = params.toString() ? `${window.location.pathname}?${params.toString()}` : window.location.pathname;
      window.history.replaceState({}, '', nextUrl);
    };

    const urlParams = new URLSearchParams(window.location.search);
    setCheckedValues('category', urlParams.getAll('category'));
    setCheckedValues('publisher', urlParams.getAll('publisher'));
    applyFilters();

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      applyFilters();
    });

    form.addEventListener('change', () => {
      applyFilters();
    });
  }
</script>
